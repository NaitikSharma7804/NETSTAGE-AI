# NetSage AI Configuration

# Environment mode: development / production / test
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./netsage.db

# LLM Configuration
# Options: mock | gemini | openai | anthropic | local
LLM_PROVIDER=mock
LLM_MODEL=mock-netsage-v1
LLM_API_KEY=

# Local LLM endpoint (if using Ollama / vLLM / LocalAI)
LOCAL_LLM_URL=http://localhost:11434/api/generate

# Demo Mode: When true, uses high-fidelity deterministic responses for all 40 cases without requiring external API keys
DEMO_MODE=true

# Prompt versioning
PROMPT_VERSION=v1.2.0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
