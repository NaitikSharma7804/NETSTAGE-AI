# NetSage AI Configuration

# OpenAI API Key (leave empty for mock/offline diagnostic mode)
OPENAI_API_KEY=

# LLM Provider: openai or mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=sqlite:///./netsage.db

# Application Configuration
APP_NAME="NetSage AI"
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
